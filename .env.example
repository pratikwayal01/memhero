# LLM (any OpenAI-compatible endpoint)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
MEMHERO_CHAT_MODEL=gpt-4o-mini
MEMHERO_EMBED_MODEL=text-embedding-3-small

# Embedding provider: "api" (default) or "local"
# Use "local" if you don't want to configure a separate embedding API key.
# First run will download the model (~90MB).
# MEMHERO_EMBED_PROVIDER=local
# MEMHERO_LOCAL_MODEL=all-MiniLM-L6-v2   # any sentence-transformers model
# MEMHERO_VECTOR_DIMS=384                # auto-detect if not set

# Postgres (docker-compose db)
MEMHERO_DATABASE_URL=postgresql://memhero:memhero@localhost:5434/memhero

# Langfuse (docker-compose langfuse)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
